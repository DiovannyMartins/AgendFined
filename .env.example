# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=          # sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=                      # sb_secret_... (server-only)

# Cloudflare Turnstile (anti-bot, §17) — both keys or neither.
# When both are set the widget renders and the gate is fail-closed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=                 # 0x... (public)
TURNSTILE_SECRET_KEY=                           # 0x... (server-only)

# Base URL for email redirects (server-only; prefer APP_URL over NEXT_PUBLIC_APP_URL).
# Also used as the Mercado Pago `back_url` (preapproval) — a public URL is required,
# since Mercado Pago rejects `localhost` (set it to the tunnel URL in dev).
APP_URL=http://localhost:3000

# Production (Vercel)
# APP_URL=https://agendfined.vercel.app

# Booking reminders (INC-2, Pro) — Edge Function `booking-reminders`.
# Until RESEND_* are set, reminders are a safe no-op (nothing sent, nothing marked).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Shared secret between the pg_cron/pg_net dispatch and the Edge Function.
REMINDER_CRON_SECRET=

# Customer self-service cancellation (INC-3). Server-only secret used to derive
# the cancellation token from a booking's public code (HMAC-SHA256). Unset = the
# end-user cancel action is disabled (fail-closed; no token is shown).
CANCEL_TOKEN_SECRET=

# Mercado Pago (PROFISSIONAL subscription, ADR 0008). Server-only access token
# used by `lib/billing/` to create a recurring preapproval (R$ 1/mês). Use a
# TEST-* token for the sandbox flow in dev; a APP_USR-* token in production.
MERCADO_PAGO_ACCESS_TOKEN=
# Webhook secret (Your integrations > Webhooks) used by `lib/billing/` to verify
# the x-signature of preapproval notifications (issue #24). Unset = the webhook
# rejects every notification (fail-closed).
MERCADO_PAGO_WEBHOOK_SECRET=
# Public URL where Mercado Pago delivers subscription (preapproval) webhook
# notifications, ending in `/api/webhooks/mercadopago`. For Subscriptions,
# Mercado Pago does NOT persist a per-preapproval `notification_url`, so this URL
# must ALSO be configured in "Your integrations" (topic `subscription_preapproval`).
# Use the tunnel URL (e.g. https://<id>.ngrok.io/api/webhooks/mercadopago) in dev
# and the deployed URL in production.
MERCADO_PAGO_NOTIFICATION_URL=

# Private scheduler secret for the future reconciliation Route Handler.
RECONCILIATION_CRON_SECRET=
